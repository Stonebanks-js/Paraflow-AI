# Paraflow AI - Environment Variables Template
# Copy this file to .env and fill in your values

# ==========================================
# BACKEND - REQUIRED
# ==========================================

SUPABASE_URL=https://txpatnmsigkmmgrbhbel.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# Only needed if this Supabase project uses legacy HS256 shared-secret JWT
# signing instead of JWKS/asymmetric signing keys (the default). Leave
# empty for JWKS-based projects.
SUPABASE_JWT_SECRET=

# Legacy backend-minted tokens for demo-mode login/register only -- NOT
# used to verify Supabase-issued tokens (see SUPABASE_JWT_SECRET above).
JWT_SECRET_KEY=your-super-secret-random-string-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# BACKEND - LLM PROVIDER (Gemini is the only supported provider)
# ==========================================

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ACTIVE_PROVIDER=gemini
ACTIVE_MODEL=
LLM_TIMEOUT_SECONDS=10

# ==========================================
# BACKEND - APPLICATION
# ==========================================

APP_NAME=Paraflow AI
APP_VERSION=1.0.0
DEBUG=False
DEMO_MODE=False

# CORS - Update with your frontend URL
CORS_ORIGINS=http://localhost:3000,https://paraflow-ai-frontend.vercel.app

# Port (auto-set by Render)
PORT=8000

# ==========================================
# FRONTEND
# ==========================================

NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_SUPABASE_URL=https://txpatnmsigkmmgrbhbel.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
