# Paraflow AI - Production Environment Variables
# Copy this file to backend/.env and fill in your values

# ==========================================
# REQUIRED - Backend cannot function without these
# ==========================================

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Only needed if this Supabase project uses legacy HS256 shared-secret JWT
# signing (Dashboard -> Settings -> API -> JWT Settings -> "JWT Secret").
# Leave empty for projects using the modern JWKS/asymmetric signing keys
# (the default) -- the backend auto-detects which mode a token uses and
# verifies it against https://<project>.supabase.co/auth/v1/.well-known/jwks.json
# when this is empty.
SUPABASE_JWT_SECRET=

# JWT Authentication (legacy backend-minted tokens for demo-mode
# login/register only -- NOT used to verify Supabase-issued tokens, which
# are validated via SUPABASE_JWT_SECRET/JWKS above instead)
JWT_SECRET_KEY=generate-a-random-64-char-secret-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# LLM PROVIDER (Gemini is the only supported provider)
# ==========================================

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ACTIVE_PROVIDER=gemini
ACTIVE_MODEL=
LLM_TIMEOUT_SECONDS=10

# ==========================================
# APPLICATION SETTINGS
# ==========================================

APP_NAME=Paraflow AI
APP_VERSION=1.0.0
DEBUG=False
DEMO_MODE=False

# CORS Origins (comma-separated - UPDATE with your frontend URL)
CORS_ORIGINS=http://localhost:3000,https://paraflow-ai-frontend.vercel.app

# Port (set automatically by Render)
PORT=8000
